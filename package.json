{
  "name": "scm-academy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --webpack",
    "build:local": "node deploy/scripts/ensure-public-lock.mjs && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma generate && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "import:pdfs": "tsx scripts/import-pdfs.ts",
    "import:book": "tsx scripts/import-book-courses.ts",
    "mark:builtin": "tsx scripts/mark-builtin-courses.ts",
    "export:builtin": "tsx scripts/export-builtin.ts",
    "check:builtin": "tsx scripts/check-builtin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.38.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "openai": "^7.8.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
